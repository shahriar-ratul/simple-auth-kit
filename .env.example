# Secrets for `docker compose up` — copy this file to `.env` and fill in real values.
# Generate each with: openssl rand -base64 32

AUTH_JWT_SECRET_NESTJS_PRISMA=
AUTH_JWT_SECRET_NESTJS_DRIZZLE=
AUTH_JWT_SECRET_EXPRESS_PRISMA=
AUTH_JWT_SECRET_EXPRESS_DRIZZLE=
AUTH_JWT_SECRET_NESTJS_PRISMA_WORKSPACES=
AUTH_JWT_SECRET_NESTJS_DRIZZLE_WORKSPACES=
AUTH_JWT_SECRET_EXPRESS_PRISMA_WORKSPACES=
AUTH_JWT_SECRET_EXPRESS_DRIZZLE_WORKSPACES=

# NextAuth session-JWT signing secret for admin-nextjs / admin-nextjs-workspaces.
AUTH_SECRET=
