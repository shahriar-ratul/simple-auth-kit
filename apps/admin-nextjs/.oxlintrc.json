{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import"
  ],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true, "es2022": true },
  // src/components/ui/** is shadcn-generated (components.json), not hand-authored — vendored,
  // don't lint.
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "out/**",
    "dist/**",
    "src/components/ui/**",
    "next-env.d.ts"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // Type-aware (oxlint-tsgolint). Reported, not blocking: fire-and-forget calls in effects and
    // event handlers are the norm here, and the previous (syntactic) linter never checked them.
    "typescript/no-floating-promises": "warn",
    // TanStack Table's useReactTable() is on React Compiler's own documented list of
    // incompatible APIs (it returns functions that can't be safely memoized) — the compiler
    // already handles this correctly by skipping memoization for it; there's no code change
    // that "fixes" a structural library incompatibility.
    "react/incompatible-library": "off",
    // Fetch-on-mount (`useEffect(() => void load())` where load() flips a loading flag before its
    // first await) is how every console page loads data; reported, not blocking.
    "react/set-state-in-effect": "warn",
    // Reported, not blocking: eslint-config-next (the previous linter) never enabled these.
    "no-unused-vars": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/img-redundant-alt": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn"
  }
}
