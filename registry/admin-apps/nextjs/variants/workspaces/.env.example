# The easy-auth backend this console administers — the *workspaces* variant
# (`easy-auth add <combo> --workspaces`), which scopes requests with an X-Workspace-Id header.
# For the plain, workspace-free console see apps/admin-nextjs.
#
# Public by design: the browser talks to the backend directly with a Bearer token, so there is no
# server-side secret in this app to protect.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3005
