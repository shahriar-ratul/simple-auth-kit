# The easy-auth backend this console administers — the *plain* variant (`easy-auth add <combo>`),
# which has no workspace concept. For the workspace-aware console see apps/admin-nextjs-workspaces.
#
# Public by design: the browser talks to the backend directly with a Bearer token, so there is no
# server-side secret in this app to protect.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001

# NextAuth v5 session-JWT signing secret. Generate one with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
