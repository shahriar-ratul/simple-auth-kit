# Base URL of the running simple-auth-kit backend, built with the workspaces variant
# (`simple-auth-kit add <combo> --workspaces`). Defaults to http://localhost:3005 when unset —
# see src/lib/auth-client.ts. This app itself serves on port 5174, so it can run alongside
# apps/admin-react (5173) against two different backends.
VITE_AUTH_API_URL=http://localhost:3005
