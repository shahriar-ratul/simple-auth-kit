{
  "name": "@easy-auth/combo-nestjs-prisma",
  "private": true,
  "version": "0.0.0",
  "description": "Reference combo: NestJS + Prisma. Two variants (base, workspaces) composed from shared/ + variants/<variant>/ — every other combo is a structural diff against this one.",
  "type": "module",
  "scripts": {
    "materialize": "node scripts/materialize.mjs",
    "prisma:generate": "node scripts/materialize.mjs --all --generate",
    "typecheck": "npm run prisma:generate && tsc -p .variant/base && tsc -p .variant/workspaces",
    "prove-cycle": "node scripts/prove-cycle.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@scalar/nestjs-api-reference": "^1.2.13",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
