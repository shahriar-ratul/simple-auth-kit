    {
      "type": "stat",
      "title": "Requests / sec",
      "description": "Every HTTP request the app served, including ones rejected by the auth and ability guards.",
      "datasource": {
        "type": "prometheus",
        "uid": "simple-auth-kit-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "simple-auth-kit-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total[$__rate_interval])) or vector(0)",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "stat",
