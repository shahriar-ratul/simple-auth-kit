{
  "name": "@simple-auth-kit/combo-express-prisma",
  "private": true,
  "version": "0.0.0",
  "description": "Structural diff of nestjs-prisma: same schema and repositories, Express routers/middleware instead of NestJS controllers/guards. Two variants (base, workspaces) composed from shared/ + variants/<variant>/.",
  "type": "module",
  "scripts": {
    "materialize": "node scripts/materialize.mjs",
    "prisma:generate": "node scripts/materialize.mjs --all --generate",
    "typecheck": "npm run prisma:generate && tsc -p .variant/base && tsc -p .variant/workspaces",
    "lint": "eslint shared variants",
    "prove-cycle": "node scripts/prove-cycle.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "@scalar/express-api-reference": "^0.10.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  }
}
