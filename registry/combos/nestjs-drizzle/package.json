{
  "name": "@easy-auth/combo-nestjs-drizzle",
  "private": true,
  "version": "0.0.0",
  "description": "Structural diff of nestjs-prisma: same NestJS controller/guard/module shape and the same two variants (base, workspaces) composed from shared/ + variants/<variant>/, with Drizzle instead of Prisma for schema + queries.",
  "type": "module",
  "scripts": {
    "materialize": "node scripts/materialize.mjs",
    "typecheck": "node scripts/materialize.mjs --all && tsc -p .variant/base && tsc -p .variant/workspaces",
    "prove-cycle": "node scripts/prove-cycle.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
