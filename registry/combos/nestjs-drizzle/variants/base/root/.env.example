DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_reference_drizzle?schema=public"

# OAuth (optional — only needed if you pass oauthProviders into AuthModule.forRoot())
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Seeder (`npm run seed`, database/seed.ts). The permission catalog and the default roles are always
# seeded; the initial admin user is created only when BOTH of these are set. There is no default
# password — with either one missing the seeder says so and skips the admin rather than putting a
# known credential on the deployment. Setting them again later is a no-op for an admin that
# already exists: their current password is left alone.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional second seeded account, held by the "superadmin" role (same full-catalog permissions
# as "admin", distinct account). Same no-default-password rule as SEED_ADMIN_* above; leaving
# any of these unset skips it. SEED_SUPERADMIN_USERNAME is optional — without it the account has
# no username and only its email logs in.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
