{
  "name": "@simple-auth-kit/combo-express-drizzle",
  "private": true,
  "version": "0.0.0",
  "description": "Structural diff of the nestjs-prisma reference combo: Express + Drizzle, no NestJS at all. Two variants (base, workspaces) composed from shared/ + variants/<variant>/.",
  "type": "module",
  "scripts": {
    "materialize": "node scripts/materialize.mjs",
    "typecheck": "node scripts/materialize.mjs --all && tsc -p .variant/base && tsc -p .variant/workspaces",
    "lint": "oxlint shared variants",
    "prove-cycle": "node scripts/prove-cycle.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "@prometheus-io/client": "^0.16.1",
    "@scalar/express-api-reference": "^0.10.19"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
