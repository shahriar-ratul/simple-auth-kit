{
  "name": "my-app",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "npm run build && npm run start:prod",
    "start:dev": "npm run build && npm run start:prod",
    "start:prod": "node dist/src/main.js",
    "seed": "tsx database/seed.ts",
    "lint": "oxlint --type-aware src test",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "vitest run --config test/vitest-e2e.config.mts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@scalar/express-api-reference": "^0.10.19",
    "argon2": "^0.45.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "@prometheus-io/client": "^0.16.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "fsevents@2.3.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ]
  }
}
