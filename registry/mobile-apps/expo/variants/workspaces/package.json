{
  "name": "mobile-expo-workspaces",
  "description": "Expo end-user mobile app consuming the workspaces easy-auth backend variant (easy-auth add <combo> --workspaces) via @easy-auth/auth-client. A deliberate copy of apps/mobile-expo rather than a shared abstraction: a consumer installs one variant, not both.",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@easy-auth/auth-client": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
