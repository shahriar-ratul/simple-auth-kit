{
  "name": "mobile-expo-workspaces",
  "description": "Expo end-user mobile app consuming the workspaces simple-auth-kit backend variant (simple-auth-kit add <combo> --workspaces) via @simple-auth-kit/auth-client. A deliberate copy of apps/mobile-expo rather than a shared abstraction: a consumer installs one variant, not both.",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "prepare": "husky"
  },
  "dependencies": {
    "@simple-auth-kit/auth-client": "^1.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@expo/metro-config": {
      "lightningcss": "1.30.1"
    }
  }
}
