# Copy to monitoring/.env — `docker compose -f monitoring/docker-compose.yml` reads it from
# there, not from the project root, because that is the directory the compose file lives in.

# Required. The stack refuses to start without it rather than defaulting to admin/admin.
# Generate one with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Optional.
# GRAFANA_ADMIN_USER=admin

# Optional — only needed to run a second stack (e.g. the other variant of this combo) alongside
# this one, since both publish the same defaults.
# MONITORING_PROJECT_NAME=express-drizzle-monitoring
# GRAFANA_PORT=3034
# PROMETHEUS_PORT=9094
# NODE_EXPORTER_PORT=9104

# If you set METRICS_TOKEN on the application, Prometheus needs the same value to scrape it.
# It cannot be read from here — Prometheus does not expand environment variables in its config —
# so paste it into the `authorization:` block in monitoring/prometheus/prometheus.yml instead.
