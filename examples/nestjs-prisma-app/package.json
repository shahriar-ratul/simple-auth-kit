{
  "name": "example-nestjs-prisma-app",
  "private": true,
  "version": "0.0.0",
  "description": "A fresh consumer project demonstrating `easy-auth add nestjs-prisma` end to end \u2014 not part of the registry's pnpm workspace, installed with plain npm like any real consumer would.",
