DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_reference?schema=public"

# OAuth (optional — only needed if you pass oauthProviders into AuthModule.forRoot())
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Docs Basic Auth (src/docs.ts). Only enforced when NODE_ENV=production — /docs and /reference
# are open in development. With NODE_ENV=production and either value missing, the docs routes
# answer 503 rather than serving unprotected.
DOCS_USERNAME=
DOCS_PASSWORD=

# Seeder (`npm run seed`, src/seed.ts). The permission catalog and the default roles are always
# seeded; the initial admin user is created only when BOTH of these are set. There is no default
# password — with either one missing the seeder says so and skips the admin rather than putting a
# known credential on the deployment. Setting them again later is a no-op for an admin that
# already exists: their current password is left alone.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
