DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_reference?schema=public"

# OAuth (optional — only needed if you pass oauthProviders into AuthModule.forRoot())
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Seeder (`npm run seed`, src/seed.ts). The permission catalog, the first workspace and that
# workspace's default roles are always seeded; the initial admin user and their membership of it
# are created only when BOTH admin variables are set. There is no default password — with either
# one missing the seeder says so and skips the admin rather than putting a known credential on
# the deployment. Setting them again later is a no-op for an admin that already exists: their
# current password is left alone.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional second seeded account and workspace membership, held by the "superadmin" role (same
# full-catalog permissions as "admin", distinct account). Same no-default-password rule as
# SEED_ADMIN_* above; leaving any of these unset skips it. SEED_SUPERADMIN_USERNAME is
# optional — without it the account has no username and only its email logs in.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=

# Name of the workspace the seeder creates (and adopts on later runs). Defaults to
# "Default workspace" when unset.
SEED_WORKSPACE_NAME=
